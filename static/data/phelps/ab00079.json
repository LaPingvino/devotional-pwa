{"pin":"AB00079","subcodes":[{"code":"AB00079","anchor":"","first_line":"O my God, my God! These are servants from whose eyes Thou hast lifted the veil, upon whom Thou hast bestowed abundant bounties, and whose vision Thou hast illumined [3.5s]... ...during His days in Iraq, the Blessed Beauty went into seclusion for two years. So concealed was the nominee of the Bab","first_line_orig":"الهی الهی هولاء عباد کشفت عن اعینهم الغطاء و جزلت لهم العطاء و نورت ابصارهم  ","language":"mixed","word_count":"1200","translations":[],"refs":[{"kind":"publication","code":"ASAT5.356-361","source":"ASAT5","locator":"356-361","url":"https://bahai-library.com/bahailib/431.pdf#page=183"},{"kind":"publication","code":"MMK4#174 p.202","source":"MMK4","locator":"174 p.202","url":"http://reference.bahai.org/fa/t/ab/SWA4/swa4-205.html"},{"kind":"publication","code":"MMK6#566","source":"MMK6","locator":"566","url":"https://bahai-library.com/bahailib/1699.pdf#page=414"},{"kind":"translation","code":"ADMS#160x","source":"ADMS","locator":"160x","url":"https://adibmasumian.com/translations/ab00079_excerpts/"}]},{"code":"AB00079ABL","anchor":"abl","translations":[{"language":"ro","lang_name":"Romanian"},{"language":"zh-Hant","lang_name":"Traditional Chinese"},{"language":"uk","lang_name":"Ukrainian"},{"language":"ar","lang_name":"Arabic"},{"language":"ja","lang_name":"Japanese"},{"language":"ky","lang_name":"Kirghiz"},{"language":"ta","lang_name":"Tamil"},{"language":"en","lang_name":"English"},{"language":"orig","lang_name":"Original"},{"language":"az","lang_name":"Azerbaijani"}]}]}
