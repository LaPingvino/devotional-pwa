{"pin":"AB00092","subcodes":[{"code":"AB00092","anchor":"","first_line":"O faithful servant of the Blessed Beauty! Thy letter was received and its contents became evident. Through the grace of God, fresh hope has been awakened [3.5s]... ...Thou didst write as to the question of spiritual discoveries. The spirit of man is a circumambient power","first_line_orig":"ای بنده صادق جمال ابهی مکتوب آنجناب واصل و مضمون واضح گشت از فضل حق امید جدید  ","language":"Per","word_count":"1140","translations":[],"writing_refs":[{"type":"swab","type_name":"Selections from the Writings of 'Abdu'l-Bahá","language":"fa","lang_name":"Persian"},{"type":"swab","type_name":"Selections from the Writings of 'Abdu'l-Bahá","language":"en","lang_name":"English"},{"type":"swab","type_name":"Selections from the Writings of 'Abdu'l-Bahá","language":"orig","lang_name":"Original"}],"refs":[{"kind":"manuscript","code":"INBA89:273","source":"INBA89","locator":"273","url":"https://afnanlibrary.org/d/inba_v089/?page=276"},{"kind":"publication","code":"AVK2.248.11x","source":"AVK2","locator":"248.11x","url":"http://reference.bahai.org/fa/t/c/AK2/ak2-249.html"},{"kind":"publication","code":"MKT3.402","source":"MKT3","locator":"402","url":"https://reference.bahai.org/fa/t/ab/MA3/ma3-402.html"},{"kind":"publication","code":"MMK1#145 p.166x","source":"MMK1","locator":"145 p.166x","url":"https://www.bahai.org/r/210652326"},{"kind":"publication","code":"MNMK#149 p.277x","source":"MNMK","locator":"149 p.277x","url":"http://reference.bahai.org/fa/t/ab/MMAB/mmab-275.html"},{"kind":"translation","code":"BSC.492 #946x","source":"BSC","locator":"492 #946x","url":"http://bahai-library.com/compilations/bahai.scriptures/"},{"kind":"translation","code":"PN_1906 p097","source":"PN_1906 p097","url":"https://bahai-library.com/pdf/p/pilgrims_notes_us-archives_1906.pdf#page=97"},{"kind":"translation","code":"SWAB#145x","source":"SWAB","locator":"145x","url":"http://www.bahai.org/r/603403312"}]}]}
