{"pin":"AB00122","subcodes":[{"code":"AB00122","anchor":"","first_line":"O my God! O my God! Thou knowest, verily, that my heart is replete… O ye friends of God and assistants of Abdu'l-Baha: When the Sun of Truth was concealed... I ask one favor of all the friends of God: It is the wish of my soul","first_line_orig":"الهی الهی انک لتعلم ان قلبی ممتلا بحب احبائک و روحی متعلق بروح اصفیائک و صدری  ","language":"mixed","word_count":"980","translations":[],"refs":[{"kind":"publication","code":"MKT1.259","source":"MKT1","locator":"259","url":"https://reference.bahai.org/fa/t/ab/MA1/ma1-258.html"},{"kind":"publication","code":"MMK5#205 p.157","source":"MMK5","locator":"205 p.157","url":"http://reference.bahai.org/fa/t/ab/SWA5/swa5-160.html"},{"kind":"publication","code":"YHA1.015x","source":"YHA1","locator":"015x","url":"https://bahai-library.com/bahailib/686.pdf#page=17"},{"kind":"translation","code":"SW_v08#13 p.180x","source":"SW_v08","locator":"13 p.180x","url":"https://bahai.works/Star_of_the_West/Volume_8/Issue_13"},{"kind":"translation","code":"SW_v08#15 p.210x","source":"SW_v08","locator":"15 p.210x","url":"https://bahai.works/Star_of_the_West/Volume_8/Issue_15"}]},{"code":"AB00122REP","anchor":"rep","translations":[{"language":"sv","lang_name":"Swedish"},{"language":"th","lang_name":"Thai"},{"language":"ja","lang_name":"Japanese"},{"language":"mn","lang_name":"Mongolian"},{"language":"ur","lang_name":"Urdu"},{"language":"ne","lang_name":"Nepali"}]}]}
