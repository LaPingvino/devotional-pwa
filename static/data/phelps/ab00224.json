{"pin":"AB00224","subcodes":[{"code":"AB00224","anchor":"","first_line":"O thou maidservant of God! Thy letter was received, and its contents testified to thy firmness in the Covenant… Now one must either say that the Blessed Beauty erred and led the people astray","first_line_orig":"ای کنیز الهی نامه شما رسید مضامین دلالت بر ثبوت بر میثاق داشت لهذا امید چنان  ","language":"mixed","word_count":"770","translations":[{"language":"en","lang_name":"English"}],"writing_refs":[{"type":"light","type_name":"Light of the World","language":"en","lang_name":"English"}],"refs":[{"kind":"publication","code":"BRL_CUHJP#86x","source":"BRL_CUHJP","locator":"86x","url":"http://reference.bahai.org/fa/t/"},{"kind":"publication","code":"MMK4#148 p.156","source":"MMK4","locator":"148 p.156","url":"http://reference.bahai.org/fa/t/ab/SWA4/swa4-159.html"},{"kind":"publication","code":"NURA#58","source":"NURA","locator":"58","url":"http://bluefin.live/wp-content/uploads/2025/01/nur-i-afaq.pdf"},{"kind":"translation","code":"BRL_ATE#068x","source":"BRL_ATE","locator":"068x","url":"http://www.bahai.org/r/256173251"},{"kind":"translation","code":"BRL_CUHJ#86x","source":"BRL_CUHJ","locator":"86x","url":"http://www.bahai.org/r/692132066"},{"kind":"translation","code":"BSTW#013","source":"BSTW","locator":"013","url":"http://www.h-net.org/~bahai/docs/vol13/Barstow_000-050.pdf#page=17"},{"kind":"translation","code":"BSTW#269","source":"BSTW","locator":"269","url":"http://www.h-net.org/~bahai/docs/vol13/Barstow_251-300.pdf#page=34"},{"kind":"translation","code":"LOTW#58","source":"LOTW","locator":"58","url":"http://www.bahai.org/r/774821855"},{"kind":"translation","code":"SW_v10#14 p.268-270","source":"SW_v10","locator":"14 p.268-270","url":"https://bahai.works/Star_of_the_West/Volume_10/Issue_14"}]}]}
