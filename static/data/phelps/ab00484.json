{"pin":"AB00484","subcodes":[{"code":"AB00484","anchor":"","first_line":"O Lord! O Thou Who graciously aidest whomsoever Thou willest, with whatsoever Thou willest, unto whatsoever Thou willest. Verily, that treasury of resignation","first_line_orig":"اللهم یا موید من یشاء بما یشاء علی ما یشاء ان معدن الرضا و منبع الوفا  ","language":"mixed","word_count":"560","translations":[{"language":"en","lang_name":"English"}],"writing_refs":[{"type":"light","type_name":"Light of the World","language":"en","lang_name":"English"}],"refs":[{"kind":"publication","code":"MKT9.009","source":"MKT9","locator":"009","url":"https://bahai-library.com/bahailib/577.pdf#page=5"},{"kind":"publication","code":"MMK4#172 p.196x","source":"MMK4","locator":"172 p.196x","url":"http://reference.bahai.org/fa/t/ab/SWA4/swa4-199.html"},{"kind":"publication","code":"MSBH1.243","source":"MSBH1","locator":"243","url":"https://bahai-library.com/bahailib/247.pdf#page=120"},{"kind":"publication","code":"NURA#69","source":"NURA","locator":"69","url":"http://bluefin.live/wp-content/uploads/2025/01/nur-i-afaq.pdf"},{"kind":"publication","code":"QUM.115x","source":"QUM","locator":"115x","url":"http://bluefin.live/wp-content/uploads/2023/10/tarikh-i-amr-i-bahai_dar_shahr-i-qum_vol1.pdf"},{"kind":"publication","code":"TSHA3.570","source":"TSHA3","locator":"570","url":"https://adibmasumian.com/wp-content/uploads/2024/12/tsha3.pdf#page=578"},{"kind":"publication","code":"YMM.473x","source":"YMM","locator":"473x","url":"https://bahai-library.com/bahailib/326.pdf#page=481"},{"kind":"translation","code":"LOTW#69","source":"LOTW","locator":"69","url":"http://www.bahai.org/r/020494000"}]}]}
