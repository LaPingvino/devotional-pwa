{"pin":"AB00587","subcodes":[{"code":"AB00587","anchor":"","first_line":"O thou who art turning to the divine Kingdom! The lengthy epistle was considered…. ... make of the Feasts occasions of joy and fellowship reminiscent of the feasts that our forebears used to hold in connection with their commemoration of the Lord's Supper... Thou hast asked regarding the naming of children","first_line_orig":"ای متوجه بملکوت الهی نامه مفصل ملاحظه گردید با وجود عدم فرصت و مهلت نظر بشدت  ","language":"Per","word_count":"500","translations":[],"refs":[{"kind":"publication","code":"AVK3.062.13x","source":"AVK3","locator":"062.13x","url":"http://reference.bahai.org/fa/t/c/AK3/ak3-66.html"},{"kind":"publication","code":"BRL_DAK#0828","source":"BRL_DAK","locator":"0828","url":"https://www.bahai.org/r/512496160"},{"kind":"publication","code":"DRM.011bx","source":"DRM","locator":"011bx"},{"kind":"publication","code":"MAS2.078-079x","source":"MAS2","locator":"078-079x","url":"http://reference.bahai.org/fa/t/ab/MAS2/mas2-79.html"},{"kind":"translation","code":"BWF.411-412x","source":"BWF","locator":"411-412x","url":"https://archive.org/details/bahaiworldfaithselectedwritingsofbahaullahandabdulbaha./mode/2up"},{"kind":"translation","code":"COC#0928x","source":"COC","locator":"0928x"},{"kind":"translation","code":"LOG#0462x","source":"LOG","locator":"0462x","url":"http://bahai-library.com/hornby_lights_guidance.html\u0026chapter=2#n462"},{"kind":"translation","code":"LOG#0946x","source":"LOG","locator":"0946x","url":"http://bahai-library.com/hornby_lights_guidance_2.html\u0026chapter=1#n946"},{"kind":"translation","code":"TAB.148-150","source":"TAB","locator":"148-150","url":"https://books.google.com/books?id=0H8yAQAAMAAJ\u0026pg=PA148"}]},{"code":"AB00587COM","anchor":"com","translations":[{"language":"tk","lang_name":"Turkmen"}]}]}
