{"pin":"AB00851","subcodes":[{"code":"AB00851","anchor":"","first_line":"My God, my God! I ask thee to forgive everything save my servitude to Thy Supreme Threshold...O thou who art calling by the Testament, in the Pivot of the horizons!... I affirm that the true meaning, the real significance, the innermost secret of these verses","first_line_orig":"الهی الهی استغفرک عن کل الشئون الا العبودیه لعتبتک السامیه و اتبرء عن کل ذکر  ","language":"mixed","word_count":"420","translations":[],"refs":[{"kind":"manuscript","code":"INBA13:327","source":"INBA13","locator":"327","url":"https://afnanlibrary.org/d/inba_v013/?page=164"},{"kind":"publication","code":"HHA.060","source":"HHA","locator":"060","url":"https://bahai-library.com/bahailib/634.pdf#page=69"},{"kind":"publication","code":"MNMK#001 p.007","source":"MNMK","locator":"001 p.007","url":"http://reference.bahai.org/fa/t/ab/MMAB/mmab-5.html"},{"kind":"publication","code":"MSHR2.152x","source":"MSHR2","locator":"152x","url":"http://reference.bahai.org/fa/t/o/MASH2/mash2-154.html"},{"kind":"publication","code":"PTFP.281","source":"PTFP","locator":"281","url":"https://bahai-library.com/bahailib/513.pdf#page=286"},{"kind":"translation","code":"BSC.265 #550","source":"BSC","locator":"265 #550","url":"http://bahai-library.com/compilations/bahai.scriptures/"},{"kind":"translation","code":"CUPAB.006-008","source":"CUPAB","locator":"006-008","url":"https://bahai-library.com/abdul-baha_compilation_utterances_station"},{"kind":"translation","code":"SW_v11#14 p.238-239","source":"SW_v11","locator":"14 p.238-239","url":"https://bahai.works/Star_of_the_West/Volume_11/Issue_14"},{"kind":"translation","code":"WOB.138x","source":"WOB","locator":"138x","url":"http://www.bahai.org/r/497677543"}]},{"code":"AB00851FRG","anchor":"frg","translations":[{"language":"tk","lang_name":"Turkmen"},{"language":"ha","lang_name":"Hausa"},{"language":"ms","lang_name":"Malay"},{"language":"ny","lang_name":"Chichewa"}]}]}
