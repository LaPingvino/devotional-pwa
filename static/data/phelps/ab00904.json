{"pin":"AB00904","subcodes":[{"code":"AB00904","anchor":"","first_line":"O thou confirmed personage! The letter that thou hast written to Aga Seyad Assadollah was read from first to last… Ye should consider the question of goodly character as of the first importance","first_line_orig":"ای شخص موید نامه ایکه باقا سید اسدالله مرقوم نموده بودید از بدایت تا نهایت  ","language":"mixed","word_count":"410","translations":[],"writing_refs":[{"type":"swab","type_name":"Selections from the Writings of 'Abdu'l-Bahá","language":"fa","lang_name":"Persian"},{"type":"swab","type_name":"Selections from the Writings of 'Abdu'l-Bahá","language":"en","lang_name":"English"},{"type":"swab","type_name":"Selections from the Writings of 'Abdu'l-Bahá","language":"orig","lang_name":"Original"}],"refs":[{"kind":"manuscript","code":"INBA85:309","source":"INBA85","locator":"309","url":"https://afnanlibrary.org/d/inba_v085/?page=311"},{"kind":"publication","code":"MJTB.076x","source":"MJTB","locator":"076x","url":"https://adibmasumian.files.wordpress.com/2023/05/mjtb.pdf"},{"kind":"publication","code":"MMK1#108 p.130x","source":"MMK1","locator":"108 p.130x","url":"https://www.bahai.org/r/288210681"},{"kind":"translation","code":"DAS.1913-10-18","source":"DAS","locator":"1913-10-18","url":"https://bahai-library.com/pdf/s/sohrab_diary_letters_1913-1914_05.pdf#page=23"},{"kind":"translation","code":"LOG#0500x","source":"LOG","locator":"0500x","url":"http://bahai-library.com/hornby_lights_guidance.html\u0026chapter=2#n500"},{"kind":"translation","code":"SWAB#108x","source":"SWAB","locator":"108x","url":"http://www.bahai.org/r/872636990"}]}]}
