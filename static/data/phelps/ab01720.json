{"pin":"AB01720","subcodes":[{"code":"AB01720","anchor":"","first_line":"O ye whom Abdu'l-Baha loveth! I have read your reports with great joy; they are of a nature to cheer and refresh the heart and gladden the soul.","first_line_orig":"ای عزیزان عبدالبهاء لایحه های شما را در نهایت ابتهاج تلاوت نمودم سبب روح و  ","language":"Per","word_count":"300","translations":[],"writing_refs":[{"type":"swab","type_name":"Selections from the Writings of 'Abdu'l-Bahá","language":"fa","lang_name":"Persian"},{"type":"swab","type_name":"Selections from the Writings of 'Abdu'l-Bahá","language":"en","lang_name":"English"},{"type":"swab","type_name":"Selections from the Writings of 'Abdu'l-Bahá","language":"orig","lang_name":"Original"}],"refs":[{"kind":"publication","code":"MMK1#040 p.079","source":"MMK1","locator":"040 p.079","url":"https://www.bahai.org/r/165558785"},{"kind":"publication","code":"NJB_v01#10 p.001-002","source":"NJB_v01","locator":"10 p.001-002","url":"https://bahai.works/Star_of_the_West/Volume_1/Issue_10"},{"kind":"translation","code":"BWF.410-410x","source":"BWF","locator":"410-410x","url":"https://archive.org/details/bahaiworldfaithselectedwritingsofbahaullahandabdulbaha./mode/2up"},{"kind":"translation","code":"SWAB#040","source":"SWAB","locator":"040","url":"http://www.bahai.org/r/863500331"},{"kind":"translation","code":"TAB.010-011","source":"TAB","locator":"010-011","url":"https://books.google.com/books?id=0H8yAQAAMAAJ\u0026pg=PA10"}]}]}
