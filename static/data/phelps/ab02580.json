{"pin":"AB02580","subcodes":[{"code":"AB02580","anchor":"","first_line":"O thou who art turned towards the Kingdom of Abhá! The call of the Abhá Beauty resoundeth from the hidden Kingdom of the unseen realm: Strive unceasingly, O people [3.5s]","first_line_orig":"ای متوجه بملکوت ابهی ندای جمال ابهی از ملکوت غیب جهان پنهان پیاپی بکوش اهل  ","language":"mixed","word_count":"240","translations":[{"language":"ky","lang_name":"Kirghiz"}],"refs":[{"kind":"manuscript","code":"INBA13:191","source":"INBA13","locator":"191","url":"https://afnanlibrary.org/d/inba_v013/?page=96"},{"kind":"manuscript","code":"INBA59:226","source":"INBA59","locator":"226","url":"https://afnanlibrary.org/d/inba_v059/?page=228"},{"kind":"publication","code":"AKHA_105BE #08 p.10","source":"AKHA_105BE #08 p.10","url":"https://afnanlibrary.org/akhbar-i-amri/"},{"kind":"publication","code":"ANDA#43-44 p.03","source":"ANDA","locator":"43-44 p.03","url":"https://www.afnanlibrary.org/d/andalib-issue-43-44"},{"kind":"publication","code":"HDQI.286","source":"HDQI","locator":"286","url":"http://reference.bahai.org/fa/t/c/HI/hi-291.html"},{"kind":"publication","code":"MKT9.169","source":"MKT9","locator":"169","url":"https://bahai-library.com/bahailib/577.pdf#page=85"},{"kind":"publication","code":"MMK5#215 p.165","source":"MMK5","locator":"215 p.165","url":"http://reference.bahai.org/fa/t/ab/SWA5/swa5-168.html"}]}]}
