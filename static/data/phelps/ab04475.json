{"pin":"AB04475","subcodes":[{"code":"AB04475","anchor":"","first_line":"O sapling of the divine garden! They say that thou art a lofty cypress in the meadowland of truth and a tender shoot by the stream of grace [3.5s]... ...O Lord! Plant this tender seedling in the garden of Thy manifold bounties, water it from the fountains","first_line_orig":"ای نهال باغ الهی گویند که در چمنستان حقیقت سرو بالائی و در جویبار عنایت نهال  ","language":"mixed","word_count":"170","translations":[{"language":"ar","lang_name":"Arabic"},{"language":"orig","lang_name":"Original"}],"refs":[{"kind":"music","code":"E. Mahony","source":"E","locator":"Mahony","url":"https://music.elikamahony.com/track/plant-this-tender-seedling"},{"kind":"publication","code":"HUV2.019x","source":"HUV2","locator":"019x","url":"http://reference.bahai.org/fa/t/ab/H2/h2-23.html"},{"kind":"publication","code":"MKT6.166","source":"MKT6","locator":"166","url":"https://reference.bahai.org/fa/t/ab/MA6/ma6-166.html"},{"kind":"translation","code":"BRL_APAB#01x","source":"BRL_APAB","locator":"01x","url":"http://www.bahai.org/r/571548807"},{"kind":"translation","code":"BRL_CHILD#10x","source":"BRL_CHILD","locator":"10x","url":"https://www.bahai.org/r/859344847"}]},{"code":"AB04475PLT","anchor":"plt","translations":[{"language":"uk","lang_name":"Ukrainian"},{"language":"fi","lang_name":"Finnish"},{"language":"ja","lang_name":"Japanese"},{"language":"eo","lang_name":"Esperanto"},{"language":"sm","lang_name":"Samoan"},{"language":"de","lang_name":"German"},{"language":"nl","lang_name":"Dutch"}]}]}
