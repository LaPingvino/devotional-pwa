{"pin":"AB06553","subcodes":[{"code":"AB06553","anchor":"","first_line":"O my God, my God! I humbly supplicate unto the Kingdom of Thy mercy, and abase myself before the dominion of Thy sovereignty, and call upon Thee with my heart [3.5s]","first_line_orig":"الهی الهی انی ابتهل الی ملکوت رحمتک و اتذلل الی جبروت سلطنتک و ادعوک بقلب  ","language":"Ara","word_count":"120","translations":[{"language":"ar","lang_name":"Arabic"},{"language":"orig","lang_name":"Original"}],"refs":[{"kind":"manuscript","code":"INBA85:430a","source":"INBA85","locator":"430a","url":"https://afnanlibrary.org/d/inba_v085/?page=432"},{"kind":"publication","code":"BRL_DAK#0151","source":"BRL_DAK","locator":"0151","url":"http://www.bahai.org/r/615464075"},{"kind":"publication","code":"MJMJ3.014","source":"MJMJ3","locator":"014","url":"http://reference.bahai.org/fa/t/ab/MMA3/mma3-16.html"},{"kind":"publication","code":"MMG2#356 p.398","source":"MMG2","locator":"356 p.398","url":"https://reference.bahai.org/fa/t/ab/MMA/mma-401.html"},{"kind":"publication","code":"YIA.223","source":"YIA","locator":"223","url":"https://adibmasumian.files.wordpress.com/2021/01/yia.pdf#page=219"},{"kind":"translation","code":"JHT_A#002","source":"JHT_A","locator":"002","url":"http://joshuahalltranslations.com/a-prayer-for-healing/"}]}]}
