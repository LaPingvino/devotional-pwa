{"pin":"AB07303","subcodes":[{"code":"AB07303","anchor":"","first_line":"O Thou pure God! Let these saplings which have sprouted by the stream of Thy guidance become fresh and verdant","first_line_orig":"ای پاک یزدان این نهالان جویبار هدایت را از باران ابر عنایت تر و تازه فرما و بنسیم  ","language":"Per","word_count":"110","full_text_parts":["O Thou pure God! Let these saplings which have sprouted by the stream of Thy guidance become fresh and verdant through the outpourings of the clouds of Thy tender mercy; cause them to be stirred by the gentle winds wafting from the meads of Thy oneness and suffer them to be revived through the rays of the Sun of Reality, that they may continually grow and flourish, and burst into blossoms and fruit.\nO Lord God! Bestow upon each one understanding; give them power and strength and cause them to mirror forth Thy divine aid and confirmation, so that they may become highly distinguished among the people.\nThou art the Mighty and the Powerful."],"translations":[{"language":"fi","lang_name":"Finnish"},{"language":"nl","lang_name":"Dutch"},{"language":"es","lang_name":"Spanish"},{"language":"en","lang_name":"English"},{"language":"de","lang_name":"German"},{"language":"eo","lang_name":"Esperanto"},{"language":"orig","lang_name":"Original"},{"language":"fa","lang_name":"Persian"}],"refs":[{"kind":"publication","code":"ADH2.125","source":"ADH2","locator":"125","url":"https://bahai-library.com/pdf/i/ishraq-khavari_adhkar_muqarrabin_2.pdf"},{"kind":"publication","code":"ADH2_5#01 p.158","source":"ADH2_5#01 p.158","url":"https://bahai-library.com/pdf/i/ishraq-khavari_adhkar_muqarrabin_2.pdf"},{"kind":"publication","code":"AKHA_124BE #04-05 p.t","source":"AKHA_124BE #04-05 p.t","url":"https://afnanlibrary.org/akhbar-i-amri/"},{"kind":"publication","code":"DUR1.576","source":"DUR1","locator":"576"},{"kind":"publication","code":"HUV1.012","source":"HUV1","locator":"012","url":"https://bahai-library.com/bahailib/621.pdf#page=12"},{"kind":"publication","code":"MJH.047b","source":"MJH","locator":"047b","url":"http://reference.bahai.org/fa/t/ab/MMAI/mmai-48.html"},{"kind":"publication","code":"MJMJ1.108","source":"MJMJ1","locator":"108"},{"kind":"publication","code":"MKT3.265","source":"MKT3","locator":"265","url":"https://reference.bahai.org/fa/t/ab/MA3/ma3-265.html"},{"kind":"publication","code":"MMG2#440 p.483","source":"MMG2","locator":"440 p.483","url":"https://reference.bahai.org/fa/t/ab/MMA/mma-486.html"},{"kind":"publication","code":"PYB#154 p.37","source":"PYB","locator":"154 p.37","url":"http://www.h-net.org/~bahai/diglib/Periodicals/Payam_i_Bahai/154.PDF#page=37"},{"kind":"publication","code":"PYB#173 p.33","source":"PYB","locator":"173 p.33","url":"http://www.h-net.org/~bahai/diglib/Periodicals/Payam_i_Bahai/173.PDF#page=33"},{"kind":"publication","code":"YQAZ.581-582","source":"YQAZ","locator":"581-582","url":"http://bluefin.live/wp-content/uploads/2023/05/yaran-i-qazvin_munjadhiban-i-jamal-i-mubin.pdf"},{"kind":"publication","code":"YQAZ.633-634","source":"YQAZ","locator":"633-634","url":"http://bluefin.live/wp-content/uploads/2023/05/yaran-i-qazvin_munjadhiban-i-jamal-i-mubin.pdf"},{"kind":"translation","code":"BRL_APAB#04","source":"BRL_APAB","locator":"04","url":"http://www.bahai.org/r/009304160"},{"kind":"translation","code":"BRL_CHILD#19","source":"BRL_CHILD","locator":"19","url":"https://www.bahai.org/r/929502574"},{"kind":"translation","code":"SW_v11#19 p.330","source":"SW_v11","locator":"19 p.330","url":"https://bahai.works/Star_of_the_West/Volume_11/Issue_19"}]}]}
