{"pin":"AB07737","subcodes":[{"code":"AB07737","anchor":"","first_line":"O Thou forgiving Lord! These servants were noble souls, and these radiant hearts were made illumined and resplendent","first_line_orig":"بخشنده یزدانا این بندگان آزادگان بودند و این جانهای تابان بنور هدایتت روشن و  ","language":"Per","word_count":"110","full_text_parts":["He is God.\n\nO Thou forgiving Lord! These servants were noble souls, and these radiant hearts were made illumined and resplendent through the light of Thy guidance. They drank a brimming cup of the wine of Thy love, and gave ear to eternal mysteries imparted by the melodies of Thy knowledge. They bound their hearts to Thee, broke free from the snare of estrangement, and laid hold of Thy unity. Make these precious souls companions of the inmates of Heaven, and admit them into the circle of Thy chosen ones. Make them intimates of Thy mysteries in the retreats of the realm above, and immerse them in the sea of lights. Thou art the Bestower, the Luminous, and the Kind."],"translations":[{"language":"ur","lang_name":"Urdu"},{"language":"fr","lang_name":"French"},{"language":"hi","lang_name":"Hindi"},{"language":"th","lang_name":"Thai"},{"language":"ja","lang_name":"Japanese"},{"language":"ta","lang_name":"Tamil"},{"language":"pl","lang_name":"Polish"},{"language":"nl","lang_name":"Dutch"},{"language":"es","lang_name":"Spanish"},{"language":"en","lang_name":"English"},{"language":"sm","lang_name":"Samoan"},{"language":"de","lang_name":"German"},{"language":"orig","lang_name":"Original"},{"language":"lo","lang_name":"Lao"},{"language":"fa","lang_name":"Persian"},{"language":"ne","lang_name":"Nepali"},{"language":"lb","lang_name":"Luxembourgish"}],"refs":[{"kind":"publication","code":"ADH2.050","source":"ADH2","locator":"050","url":"https://bahai-library.com/pdf/i/ishraq-khavari_adhkar_muqarrabin_2.pdf"},{"kind":"publication","code":"ADH2_6#01 p.167","source":"ADH2_6#01 p.167","url":"https://bahai-library.com/pdf/i/ishraq-khavari_adhkar_muqarrabin_2.pdf"},{"kind":"publication","code":"AKHA_118BE #03-04 p.226","source":"AKHA_118BE #03-04 p.226","url":"https://afnanlibrary.org/akhbar-i-amri/"},{"kind":"publication","code":"BRL_DAK#0107","source":"BRL_DAK","locator":"0107","url":"http://www.bahai.org/r/510773524"},{"kind":"publication","code":"BRL_MON#12","source":"BRL_MON","locator":"12","url":"http://www.bahai.org/r/109006926"},{"kind":"publication","code":"BSHN.140.385","source":"BSHN","locator":"140.385","url":"http://reference.bahai.org/fa/t/c/BN/bn-392.html"},{"kind":"publication","code":"BSHN.144.380","source":"BSHN","locator":"144.380"},{"kind":"publication","code":"DUR1.045","source":"DUR1","locator":"045"},{"kind":"publication","code":"DUR1.386","source":"DUR1","locator":"386"},{"kind":"publication","code":"MHT1a.053","source":"MHT1a.053","url":"https://bahai-library.com/bahailib/183.pdf#page=54"},{"kind":"publication","code":"MHT1b.011","source":"MHT1b.011","url":"https://bahai-library.com/bahailib/185.pdf#page=11"},{"kind":"publication","code":"MJH.034a","source":"MJH","locator":"034a","url":"http://reference.bahai.org/fa/t/ab/MMAI/mmai-35.html"},{"kind":"publication","code":"MJMJ1.086","source":"MJMJ1","locator":"086"},{"kind":"publication","code":"MMG2#368 p.410","source":"MMG2","locator":"368 p.410","url":"https://reference.bahai.org/fa/t/ab/MMA/mma-413.html"},{"kind":"translation","code":"BRL_POAB#12","source":"BRL_POAB","locator":"12","url":"http://www.bahai.org/r/874596033"}]}]}
