{"pin":"AB08487","subcodes":[{"code":"AB08487","anchor":"","first_line":"O God, my God! Give me to drink from the cup of Thy bestowal and illumine my face","first_line_orig":"الهی الهی انلنی کاس العطاء و نور وجهی بنور الهدی و ثبتنی علی الوفاء و  ","language":"mixed","word_count":"90","full_text_parts":["O God, my God!  Give me to drink from the cup of Thy bestowal and illumine my face with the light of guidance.  Make me firm in the path of faithfulness, assist me to be steadfast in Thy mighty Covenant, and suffer me to be numbered with Thy chosen servants.  Unlock before my face the doors of abundance, grant me deliverance, and sustain me, through means I cannot reckon, from the treasuries of heaven.  Suffer me to turn my face toward the countenance of Thy generosity and to be entirely devoted to Thee, O Thou Who art merciful and compassionate!  To those that stand fast and firm in Thy Covenant Thou, verily, art gracious and generous.  All praise be to God, the Lord of the worlds!"],"translations":[{"language":"tk","lang_name":"Turkmen"},{"language":"ja","lang_name":"Japanese"},{"language":"nl","lang_name":"Dutch"},{"language":"es","lang_name":"Spanish"},{"language":"en","lang_name":"English"},{"language":"ny","lang_name":"Chichewa"},{"language":"de","lang_name":"German"},{"language":"orig","lang_name":"Original"},{"language":"fa","lang_name":"Persian"},{"language":"mn","lang_name":"Mongolian"}],"refs":[{"kind":"music","code":"almunajat.com [item 12]","source":"almunajat","locator":"com [item 12]","url":"https://almunajat.com/chanting_collection_3.htm"},{"kind":"publication","code":"ADH2.053","source":"ADH2","locator":"053","url":"https://bahai-library.com/pdf/i/ishraq-khavari_adhkar_muqarrabin_2.pdf"},{"kind":"publication","code":"ADH2_2#01 p.086","source":"ADH2_2#01 p.086","url":"https://bahai-library.com/pdf/i/ishraq-khavari_adhkar_muqarrabin_2.pdf"},{"kind":"publication","code":"AHDW.034","source":"AHDW","locator":"034"},{"kind":"publication","code":"BRL_DAK#0056","source":"BRL_DAK","locator":"0056","url":"http://www.bahai.org/r/997273176"},{"kind":"publication","code":"KNSA.272x","source":"KNSA","locator":"272x","url":"https://bahai-library.com/bahailib/329.pdf#page=276"},{"kind":"publication","code":"MJH.069b","source":"MJH","locator":"069b","url":"http://reference.bahai.org/fa/t/ab/MMAI/mmai-70.html"},{"kind":"publication","code":"MJMJ1.026","source":"MJMJ1","locator":"026"},{"kind":"publication","code":"MMG2#198 p.226","source":"MMG2","locator":"198 p.226","url":"https://reference.bahai.org/fa/t/ab/MMA/mma-229.html"},{"kind":"translation","code":"BRL_APAB#16","source":"BRL_APAB","locator":"16","url":"http://www.bahai.org/r/196496356"},{"kind":"translation","code":"DAS.1913-10-17","source":"DAS","locator":"1913-10-17","url":"https://bahai-library.com/pdf/s/sohrab_diary_letters_1913-1914_05.pdf#page=20"},{"kind":"translation","code":"MNYA.378x","source":"MNYA","locator":"378x","url":"https://bahai-library.com/afroukhteh_nine_years_akka"},{"kind":"translation","code":"SW_v14#06 p.167","source":"SW_v14","locator":"06 p.167","url":"https://bahai.works/Star_of_the_West/Volume_14/Issue_6"}]}]}
