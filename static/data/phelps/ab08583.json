{"pin":"AB08583","subcodes":[{"code":"AB08583","anchor":"","first_line":"O servant of the Abha Beauty! Thy letter was received. Thou hast written of being deprived of communications for some time… Thou has enquired regarding a certain passage from the Epistle addressed to the Wolf","first_line_orig":"ای بنده جمال ابهی نامه شما رسید مرقوم نموده بودید که مدتیست از مکاتیب محروم  ","language":"mixed","word_count":"200","translations":[{"language":"fa","lang_name":"Persian"},{"language":"orig","lang_name":"Original"},{"language":"en","lang_name":"English"}],"writing_refs":[{"type":"light","type_name":"Light of the World","language":"orig","lang_name":"Original"},{"type":"light","type_name":"Light of the World","language":"fa","lang_name":"Persian"},{"type":"light","type_name":"Light of the World","language":"en","lang_name":"English"}],"refs":[{"kind":"publication","code":"BRL_DAK#0257","source":"BRL_DAK","locator":"0257","url":"http://www.bahai.org/r/101868014"},{"kind":"publication","code":"MMK4#008 p.006x","source":"MMK4","locator":"008 p.006x","url":"http://reference.bahai.org/fa/t/ab/SWA4/swa4-9.html"},{"kind":"publication","code":"NURA#13","source":"NURA","locator":"13","url":"http://bluefin.live/wp-content/uploads/2025/01/nur-i-afaq.pdf"},{"kind":"publication","code":"YMM.164x","source":"YMM","locator":"164x","url":"https://bahai-library.com/bahailib/326.pdf#page=172"},{"kind":"translation","code":"LOTW#13","source":"LOTW","locator":"13","url":"http://www.bahai.org/r/896295335"}]}]}
