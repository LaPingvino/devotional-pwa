{"pin":"AB09344","subcodes":[{"code":"AB09344","anchor":"","first_line":"O dear daughter! Your letter has arrived. Its contents were of the highest sweetness, for it shows steadfastness and firmness. ...Rest assured that the breathings of the Holy Spirit will loosen thy tongue. Speak, therefore; speak out with great courage at every meeting","first_line_orig":"ای دختر عزیز نامه تو رسید مضمون بی نهایت شیرین بود زیرا دلیل بر ثبوت و  ","language":"Per","word_count":"260","translations":[],"writing_refs":[{"type":"swab","type_name":"Selections from the Writings of 'Abdu'l-Bahá","language":"fa","lang_name":"Persian"},{"type":"swab","type_name":"Selections from the Writings of 'Abdu'l-Bahá","language":"en","lang_name":"English"},{"type":"swab","type_name":"Selections from the Writings of 'Abdu'l-Bahá","language":"orig","lang_name":"Original"}],"refs":[{"kind":"publication","code":"MMK1#216 p.259x","source":"MMK1","locator":"216 p.259x","url":"https://www.bahai.org/r/136833018"},{"kind":"translation","code":"BBBD.262-263","source":"BBBD","locator":"262-263"},{"kind":"translation","code":"BRL_MEET.AB#19x","source":"BRL_MEET","locator":"AB#19x","url":"http://www.bahai.org/r/208045681"},{"kind":"translation","code":"COC#0932x","source":"COC","locator":"0932x"},{"kind":"translation","code":"SWAB#216x","source":"SWAB","locator":"216x","url":"http://www.bahai.org/r/625319353"}]}]}
