{"pin":"AB10275","subcodes":[{"code":"AB10275","anchor":"","first_line":"Remove not, O Lord, the festal board that hath been spread in Thy Name","word_count":"70","full_text_parts":["Remove not, O Lord, the festal board that hath been spread in Thy Name, and extinguish not the burning flame that hath been kindled by Thine unquenchable fire. Withhold not from flowing that living water of Thine that murmureth with the melody of Thy glory and Thy remembrance, and deprive not Thy servants from the fragrance of Thy sweet savors breathing forth the perfume of Thy love.\nLord!  Turn the distressing cares of Thy holy ones into ease, their hardship into comfort, their abasement into glory, their sorrow into blissful joy, O Thou that holdest in Thy grasp the reins of all mankind!\nThou art, verily, the One, the Single, the Mighty, the All-Knowing, the All-Wise."],"translations":[{"language":"ml","lang_name":"Malayalam"},{"language":"ru","lang_name":"Russian"},{"language":"es","lang_name":"Spanish"},{"language":"bg","lang_name":"Bulgarian"},{"language":"bs","lang_name":"Bosnian"},{"language":"ro","lang_name":"Romanian"},{"language":"lb","lang_name":"Luxembourgish"},{"language":"tl","lang_name":"Tagalog"},{"language":"uk","lang_name":"Ukrainian"},{"language":"fi","lang_name":"Finnish"},{"language":"hy","lang_name":"Armenian"},{"language":"mg","lang_name":"Malagasy"},{"language":"ja","lang_name":"Japanese"},{"language":"pt","lang_name":"Portuguese"},{"language":"da","lang_name":"Danish"},{"language":"fr","lang_name":"French"},{"language":"hr","lang_name":"Croatian"},{"language":"ky","lang_name":"Kirghiz"},{"language":"sne","lang_name":"Bau Bidayuh"},{"language":"ta","lang_name":"Tamil"},{"language":"zh-Hans","lang_name":"Simplified Chinese"},{"language":"hu","lang_name":"Hungarian"},{"language":"af","lang_name":"Afrikaans"},{"language":"pl","lang_name":"Polish"},{"language":"ca","lang_name":"Catalan"},{"language":"en","lang_name":"English"},{"language":"el","lang_name":"Greek"},