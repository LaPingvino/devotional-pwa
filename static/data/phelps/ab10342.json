{"pin":"AB10342","subcodes":[{"code":"AB10342","anchor":"","first_line":"O ye children of the Kingdom! Give thanks unto God that, at this tender age, ye have entered into the Divine Kingdom… O Compassionate God! O Lord of Hosts! Praise be unto Thee that Thou hast preferred these little children over the full-grown and mature","first_line_orig":"ای خدای مهربان ای ربّ الجنود شکر ترا که این اطفال صغیر را بر بالغان کبیر ترجیح دادی  ","language":"Per","word_count":"140","translations":[],"refs":[{"kind":"publication","code":"HUV2.015x","source":"HUV2","locator":"015x","url":"http://reference.bahai.org/fa/t/ab/H2/h2-19.html"},{"kind":"translation","code":"BRL_APAB#14x","source":"BRL_APAB","locator":"14x","url":"http://www.bahai.org/r/538807367"},{"kind":"translation","code":"BRL_APAB#24","source":"BRL_APAB","locator":"24","url":"http://www.bahai.org/r/578804711"},{"kind":"translation","code":"BRL_CHILD#23x","source":"BRL_CHILD","locator":"23x","url":"https://www.bahai.org/r/968095169"},{"kind":"translation","code":"SW_v11#15 p.258","source":"SW_v11","locator":"15 p.258","url":"https://bahai.works/Star_of_the_West/Volume_11/Issue_15"}]},{"code":"AB10342COM","anchor":"com","translations":[{"language":"nl","lang_name":"Dutch"},{"language":"es","lang_name":"Spanish"},{"language":"en","lang_name":"English"},{"language":"eo","lang_name":"Esperanto"}]},{"code":"AB10342THK","anchor":"thk","translations":[{"language":"en","lang_name":"English"}]}]}
