{"pin":"AB10685","subcodes":[{"code":"AB10685","anchor":"","first_line":"O Thou most glorious Lord! Make this little maidservant of Thine blessed and happy; cause her to be cherished","first_line_orig":"این مناجاترا بخوان ای جلیل اکبر این کنیز صغیر را دختر خوش اختر فرما و در درگاه احدیتت  ","language":"Per","word_count":"60","full_text_parts":["O Thou most glorious Lord!\n\nMake this little maidservant of Thine blessed and happy; cause her to be cherished at the threshold of Thy oneness and let her drink deep from the cup of Thy love so that she may be filled with rapture and ecstasy and diffuse sweet-scented fragrance. Thou art the Mighty and the Powerful, and Thou art the All-Knowing, the All-Seeing."],"translations":[{"language":"ml","lang_name":"Malayalam"},{"language":"es","lang_name":"Spanish"},{"language":"bs","lang_name":"Bosnian"},{"language":"ro","lang_name":"Romanian"},{"language":"zh-Hant","lang_name":"Traditional Chinese"},{"language":"uk","lang_name":"Ukrainian"},{"language":"ar","lang_name":"Arabic"},{"language":"fi","lang_name":"Finnish"},{"language":"iba","lang_name":"Iban"},{"language":"ja","lang_name":"Japanese"},{"language":"pt","lang_name":"Portuguese"},{"language":"mn","lang_name":"Mongolian"},{"language":"fa","lang_name":"Persian"},{"language":"kn","lang_name":"Kannada"},{"language":"ta","lang_name":"Tamil"},{"language":"ko","lang_name":"Korean"},{"language":"hu","lang_name":"Hungarian"},{"language":"pl","lang_name":"Polish"},{"language":"ca","lang_name":"Catalan"},{"language":"en","lang_name":"English"},{"language":"el","lang_name":"Greek"},{"language":"ht","lang_name":"Haitian Creole"},{"language":"orig","lang_name":"Original"},{"language":"az","lang_name":"Azerbaijani"},{"language":"sq","lang_name":"Albanian"},{"language":"it","lang_name":"Italian"},{"language":"sk","lang_name":"Slovak"},{"language":"nl","lang_name":"Dutch"},{"language":"tvl","lang_name":"Tuvalu"}],"refs":[{"kind":"music","code":"A. Youssefi","source":"A","locator":"Youssef