{"pin":"AB10714","subcodes":[{"code":"AB10714","anchor":"","first_line":"O Thou kind Lord! These lovely children are the handiwork of the fingers of Thy might and the wondrous signs of Thy greatness.","first_line_orig":"خداوندا مهربانا این اطفال نازنین صنع دست قدرت تو است و ایات عظمت تو خدایا این  ","language":"Per","word_count":"60","full_text_parts":["O Thou kind Lord! These lovely children are the handiwork of the fingers of Thy might and the wondrous signs of Thy greatness. O God! Protect these children, graciously assist them to be educated and enable them to render service to the world of humanity. O God! These children are pearls, cause them to be nurtured within the shell of Thy loving-kindness.\n\nThou art the Bountiful, the All-Loving."],"translations":[{"language":"ml","lang_name":"Malayalam"},{"language":"ru","lang_name":"Russian"},{"language":"es","lang_name":"Spanish"},{"language":"bg","lang_name":"Bulgarian"},{"language":"bs","lang_name":"Bosnian"},{"language":"ro","lang_name":"Romanian"},{"language":"med","lang_name":"Melpa"},{"language":"id","lang_name":"Indonesian"},{"language":"zh-Hant","lang_name":"Traditional Chinese"},{"language":"lg","lang_name":"Ganda"},{"language":"tl","lang_name":"Tagalog"},{"language":"mh","lang_name":"Marshallese"},{"language":"th","lang_name":"Thai"},{"language":"iba","lang_name":"Iban"},{"language":"hy","lang_name":"Armenian"},{"language":"kl","lang_name":"Kalaallisut"},{"language":"ja","lang_name":"Japanese"},{"language":"gux","lang_name":"Gourmanchéma"},{"language":"pt","lang_name":"Portuguese"},{"language":"mn","lang_name":"Mongolian"},{"language":"fa","lang_name":"Persian"},{"language":"da","lang_name":"Danish"},{"language":"fr","lang_name":"French"},{"language":"tet","lang_name":"Tetum"},{"language":"ky","lang_name":"Kirghiz"},{"language":"ta","lang_name":"Tamil"},{"language":"zh-Hans","lang_name":"Simplified Chinese"},{"language":"hu","lang_name":"Hungarian"},{"language":"naq","lang_name":"Khoekhoegowab"},{"langua