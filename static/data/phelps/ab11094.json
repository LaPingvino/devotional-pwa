{"pin":"AB11094","subcodes":[{"code":"AB11094","anchor":"","title":"Prayer for the departed.","first_line":"O my God! O Thou forgiver of sins, bestower of gifts, dispeller of afflictions!","word_count":"50","full_text_parts":["O my God!  O Thou forgiver of sins, bestower of gifts, dispeller of afflictions!\nVerily, I beseech thee to forgive the sins of such as have abandoned the physical garment and have ascended to the spiritual world.\nO my Lord!  Purify them from trespasses, dispel their sorrows, and change their darkness into light.  Cause them to enter the garden of happiness, cleanse them with the most pure water, and grant them to behold Thy splendors on the loftiest mount."],"translations":[{"language":"ml","lang_name":"Malayalam"},{"language":"ru","lang_name":"Russian"},{"language":"bi","lang_name":"Bislama"},{"language":"es","lang_name":"Spanish"},{"language":"bg","lang_name":"Bulgarian"},{"language":"bs","lang_name":"Bosnian"},{"language":"et","lang_name":"Estonian"},{"language":"ro","lang_name":"Romanian"},{"language":"id","lang_name":"Indonesian"},{"language":"lg","lang_name":"Ganda"},{"language":"sv","lang_name":"Swedish"},{"language":"tl","lang_name":"Tagalog"},{"language":"uk","lang_name":"Ukrainian"},{"language":"mh","lang_name":"Marshallese"},{"language":"no","lang_name":"Norwegian"},{"language":"fi","lang_name":"Finnish"},{"language":"mt","lang_name":"Maltese"},{"language":"kl","lang_name":"Kalaallisut"},{"language":"mg","lang_name":"Malagasy"},{"language":"ja","lang_name":"Japanese"},{"language":"gux","lang_name":"Gourmanchéma"},{"language":"pt","lang_name":"Portuguese"},{"language":"kwn","lang_name":"Rukwangali"},{"language":"kn","lang_name":"Kannada"},{"language":"da","lang_name":"Danish"},{"language":"fr","lang_name":"French"},{"language":"hr","lang_name":"Croatian"},{"language":"tet","lang_name":"Tetum"},{"language":"ky","lang_name":"Kirghiz"},{"language":"sne","lang_name":"Bau Bidayuh"},{"language":"ta","lang_name":"Tamil"},{"language":"bn",