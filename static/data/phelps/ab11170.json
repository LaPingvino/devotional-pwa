{"pin":"AB11170","subcodes":[{"code":"AB11170","anchor":"","first_line":"O my God, may my life be a sacrifice for Thy loved ones! Shed Thou this languid blood of mine upon the ground in the way of Thy companions, and make this withered body the dust that Thy friends tread underfoot as they walk their path, O my God!","first_line_orig":"ای خدای من جانم فدای احبابت این خون افسرده را بر سبیل دوستانت بر خاک ریز و  ","language":"Per","word_count":"40","translations":[{"language":"fa","lang_name":"Persian"},{"language":"en","lang_name":"English"},{"language":"orig","lang_name":"Original"}],"refs":[{"kind":"music","code":"S. Toloui-Wallace","source":"S","locator":"Toloui-Wallace","url":"https://youtu.be/XIphhmV8WbM"},{"kind":"publication","code":"DUR2.210","source":"DUR2","locator":"210"},{"kind":"publication","code":"MJH.021b","source":"MJH","locator":"021b","url":"http://reference.bahai.org/fa/t/ab/MMAI/mmai-22.html"},{"kind":"publication","code":"MJMJ1.061b","source":"MJMJ1","locator":"061b"},{"kind":"publication","code":"MMG2#404 p.450","source":"MMG2","locator":"404 p.450","url":"https://reference.bahai.org/fa/t/ab/MMA/mma-453.html"},{"kind":"translation","code":"ADMS#136","source":"ADMS","locator":"136","url":"https://adibmasumian.com/translations/ab11170/"}]}]}
