{"pin":"AB11249","subcodes":[{"code":"AB11249","anchor":"","first_line":"...O Lord! Help this daughter of the Kingdom to be exalted in both worlds","first_line_orig":"ای پروردگار این دختر ملکوت را در دو جهان عزیز نما از جهان خاک و خاکیان بیزار کن  ","language":"Per","word_count":"40","full_text_parts":["O Lord! Help this daughter of the Kingdom to be exalted in both worlds; cause her to turn away from this mortal world of dust and from those who have set their hearts thereon and enable her to have communion and close association with the world of immortality. Give her heavenly power and strengthen her through the breaths of the Holy Spirit that she may arise to serve Thee. Thou art the Mighty One.\n\n\n* The Divine Art of Living, p. 120"],"translations":[],"writing_refs":[{"type":"apab","type_name":"Additional Prayers Revealed by ‘Abdu’l-Bahá","language":"en","lang_name":"English"}],"refs":[{"kind":"music","code":"E. Mahony","source":"E","locator":"Mahony","url":"https://music.elikamahony.com/track/blessings-for-women"},{"kind":"publication","code":"HUV2.020x","source":"HUV2","locator":"020x","url":"http://reference.bahai.org/fa/t/ab/H2/h2-24.html"},{"kind":"translation","code":"BRL_APAB#05x","source":"BRL_APAB","locator":"05x","url":"http://www.bahai.org/r/676221640"},{"kind":"translation","code":"BRL_CHILD#27","source":"BRL_CHILD","locator":"27","url":"https://www.bahai.org/r/758413479"}]},{"code":"AB11249DAU","anchor":"dau","translations":[{"language":"nl","lang_name":"Dutch"},{"language":"es","lang_name":"Spanish"},{"language":"sm","lang_name":"Samoan"},{"language":"eo","lang_name":"Esperanto"},{"language":"en","lang_name":"English"},{"language":"ms","lang_name":"Malay"},{"language":"pt","lang_name":"Portuguese"},{"language":"tvl","lang_name":"Tuvalu"},{"language":"de","lang_name":"German"},{"language":"gil","lang_name":"Gilbertese"}],"writing_refs":[{"type":"apab","type_name":"Additional Prayers Revealed by ‘Abdu’l-Bahá","language":"pt","lang_name":"Portuguese"