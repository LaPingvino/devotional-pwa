{"pin":"AB11372","subcodes":[{"code":"AB11372","anchor":"","first_line":"O thou who art enkindled with the fire of the love of God! Thy letter was received and its contents brought joy. It is evidence of thy devotion [3.5s]... ...Whensoever a company of people shall gather in a meeting place, shall engage in glorifying God","first_line_orig":"ای مشتعل بنار محبت الله نامه شما رسید و از مضمون سرور حاصل گردید دلیل بر توجه  ","language":"Per","word_count":"170","translations":[],"writing_refs":[{"type":"swab","type_name":"Selections from the Writings of 'Abdu'l-Bahá","language":"fa","lang_name":"Persian"},{"type":"swab","type_name":"Selections from the Writings of 'Abdu'l-Bahá","language":"en","lang_name":"English"},{"type":"swab","type_name":"Selections from the Writings of 'Abdu'l-Bahá","language":"orig","lang_name":"Original"}],"refs":[{"kind":"publication","code":"BRL_DAK#0242","source":"BRL_DAK","locator":"0242","url":"http://www.bahai.org/r/861969482"},{"kind":"publication","code":"MMK1#056 p.091x","source":"MMK1","locator":"056 p.091x","url":"https://www.bahai.org/r/873482129"},{"kind":"translation","code":"SWAB#056x","source":"SWAB","locator":"056x","url":"http://www.bahai.org/r/045348075"}]},{"code":"AB11372WHE","anchor":"whe","translations":[{"language":"sq","lang_name":"Albanian"}]}]}
