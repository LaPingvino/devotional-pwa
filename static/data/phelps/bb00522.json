{"pin":"BB00522","subcodes":[{"code":"BB00522","anchor":"","title":"Du'a Hajat","first_line":"O Lord! Send down Thy mercy upon me, for verily all mercy is Thine.... O Lord! Unto Thee I repair for refuge and toward all Thy signs I set my heart. O Lord! Whether traveling or at home","first_line_orig":"بسم الله الرحمن الرحیم. اللهم انزل علی رحمتک فان لک الرحمة کلها اللهم صل على محمد حبیبک و الانبیآء  ","language":"Ara","word_count":"180","subjects":"@prayer for protection, @trust and reliance in God; turning to Him at all times, @prayer for forgiveness","full_text_parts":["O Lord! Unto Thee I repair for refuge, and toward all Thy signs I set my heart.\nO Lord!  Whether traveling or at home, and in my occupation or in my work, I place my whole trust in Thee.\nGrant me then Thy sufficing help so as to make me independent of all things, O Thou Who art unsurpassed in Thy mercy!\nBestow upon me my portion, O Lord, as Thou pleasest, and cause me to be satisfied with whatsoever Thou hast ordained for me.\nThine is the absolute authority to command."],"translations":[],"writing_refs":[{"type":"swb","type_name":"Selections from the Writings of the Báb","language":"ar","lang_name":"Arabic"},{"type":"swb","type_name":"Selections from the Writings of the Báb","language":"orig","lang_name":"Original"}],"refs":[{"kind":"manuscript","code":"INBA64:017.13-024.03","source":"INBA64","locator":"017.13-024.03","url":"https://afnanlibrary.org/d/inba_v064/?page=19"},{"kind":"music","code":"B. Khademi","source":"B","locator":"Khademi","url":"https://baharehkhademi.bandcamp.com/track/detachment-prayer"},{"kind":"music","code":"Bea \u0026 Arthur Joy","source":"Bea \u0026 Arthur Joy","url":"https://youtu.be/2TyqG7Sg2qY"},{"kind":"music","code":"C. Signori","source":"C","locator":"Signori","url":"https://hambredesentido.bandcamp.com/track/desprendimiento"},{"kind":"music","code":"D. Khavari","source":"D","locator":"Khavari","url":"https://youtu.be/v1PxF1LhdnQ"},{"kind":"music","code":"D. Sylvester","source":"D","locator":"Sylvester","url":"https://youtu.be/WkMJjzGPwTo"},{"kind":"music","code":"E. Kuitunen","source":"E","locator":"Kuitunen","url":"https://youtu.be/rGOrvxJeQe8"},{"kind":"music","code":"E. Mahony","source":"E","locator":"Mahony","url":"https://music.elikamahony.com/track/unto-thee-i-repair-for-refuge"},{"kind":"music","code":"Juliet \u0026 Amelia","source":"Juliet \u0026 Amelia","url":"https://youtu.be/xT-louq70hM"},{"kind":"music","code":"K. Porray","source":"K","locator":"Porray","url":"https://soundcloud.com/katyporray/11-unto-thee-i-repair"},{"kind":"music","code":"Kiya \u0026 Parya","source":"Kiya \u0026 Parya","url":"https://kiyaparya.bandcamp.com/track/trust-in-thee"},{"kind":"music","code":"L. Slott","source":"L","locator":"Slott","url":"https://lukeslott.bandcamp.com/track/bestow-upon-me"},{"kind":"music","code":"Ladjamaya","source":"Ladjamaya","url":"https://youtu.be/8jCiLrYTx1E"},{"kind":"music","code":"M. Stamper","source":"M","locator":"Stamper","url":"https://fastheartmart.bandcamp.com/track/repair-for-refuge-bahai-prayer"},{"kind":"music","code":"N. Hamilton","source":"N","locator":"Hamilton","url":"https://noahethamilton.bandcamp.com/track/repair-for-refuge"},{"kind":"music","code":"Nabilinho","source":"Nabilinho","url":"https://youtu.be/v2YzeRrzr0Q"},{"kind":"music","code":"Refuge","source":"Refuge","url":"https://refugemusic.bandcamp.com/track/refuge"},{"kind":"music","code":"Rosalynd \u0026 Pascal","source":"Rosalynd \u0026 Pascal","url":"https://youtu.be/3kGmqeMYQsk"},{"kind":"music","code":"S. Gould","source":"S","locator":"Gould","url":"https://youtu.be/-Vcle7q8vcw"},{"kind":"music","code":"S. Jaberi (?)","source":"S","locator":"Jaberi (?)","url":"https://youtu.be/W3KS0VzQMBY"},{"kind":"music","code":"Soulrise Melodies","source":"Soulrise Melodies","url":"https://soulrisemelodies.bandcamp.com/track/repair-for-refuge"},{"kind":"music","code":"Strong Steep","source":"Strong Steep","url":"https://strongsteep.bandcamp.com/tr