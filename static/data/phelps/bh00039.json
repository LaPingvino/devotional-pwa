{"pin":"BH00039","subcodes":[{"code":"BH00039","anchor":"","first_line":"O Ibrahim! Indeed thy name hath been mentioned in this most exalted station before the presence of the Lord of all mankind [3.5s]... ...O Lord my God! Thy knowledge of me doth verily surpass my understanding of my own self. I implore Thee to enable me to so rise to serve Thee","first_line_orig":"یا ابراهیم قد حضر اسمک فی هذا المقام الاعلی امام حضور مولی الوری ذکرک  ","language":"mixed","word_count":"6840","translations":[],"refs":[{"kind":"manuscript","code":"BLIB_Or15715.207x","source":"BLIB_Or15715","locator":"207x"},{"kind":"manuscript","code":"INBA81:181.11x","source":"INBA81","locator":"181.11x","url":"https://afnanlibrary.org/d/inba_v081/?page=184"},{"kind":"publication","code":"ADM2#023 p.041x","source":"ADM2","locator":"023 p.041x","url":"https://bahai-library.com/bahailib/558.pdf#page=41"},{"kind":"publication","code":"AQA6#299 p.292","source":"AQA6","locator":"299 p.292","url":"https://bahai-library.com/bahailib/567.pdf"},{"kind":"translation","code":"JHT_S#046x","source":"JHT_S","locator":"046x","url":"https://joshuahalltranslations.com/jalal/2017/10/Supplications-by-Bahaullah-1.pdf#page=22"}]},{"code":"BH00039HUS","anchor":"hus","translations":[{"language":"zh-Hans","lang_name":"Simplified Chinese"},{"language":"en","lang_name":"English"},{"language":"zh-Hant","lang_name":"Traditional Chinese"},{"language":"lo","lang_name":"Lao"}]}]}
