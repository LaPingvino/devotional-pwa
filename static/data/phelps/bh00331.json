{"pin":"BH00331","subcodes":[{"code":"BH00331","anchor":"","first_line":"This is a Book from Our presence unto him who hath been named the Beloved, that he may be remembered through the remembrance of God - and verily his mention was foreordained [3.5s]... ...Glory be unto Thee, O Lord my God! Purify the hearts of Thy servants with the waters of Thy mercy and loving-kindness","first_line_orig":"هذا کتاب من لدنا الی الذی سمی بالحبیب لیکون بذکر الله مذکورا و ان ذکره سبق  ","language":"mixed","word_count":"1980","translations":[],"refs":[{"kind":"manuscript","code":"BLIB_Or07852.068","source":"BLIB_Or07852","locator":"068"},{"kind":"manuscript","code":"BLIB_Or15725.469x","source":"BLIB_Or15725","locator":"469x"},{"kind":"manuscript","code":"NLAI_BH2.014.10x","source":"NLAI_BH2","locator":"014.10x","url":"http://bluefin.live/wp-content/uploads/2022/08/NLAI.BH2_.pdf#page=14"},{"kind":"publication","code":"ADM2#089 p.166x","source":"ADM2","locator":"089 p.166x","url":"https://bahai-library.com/bahailib/558.pdf#page=166"},{"kind":"publication","code":"AVK3.006.12x","source":"AVK3","locator":"006.12x","url":"http://reference.bahai.org/fa/t/c/AK3/ak3-10.html"},{"kind":"publication","code":"BRL_DA#070","source":"BRL_DA","locator":"070","url":"http://www.bahai.org/r/391626983"},{"kind":"publication","code":"PYK.010","source":"PYK","locator":"010","url":"https://bahai-library.com/bahailib/1484.pdf#page=27"},{"kind":"translation","code":"JHT_S#056x","source":"JHT_S","locator":"056x","url":"https://joshuahalltranslations.com/jalal/2017/10/Supplications-by-Bahaullah-1.pdf#page=26"}]},{"code":"BH00331FOR","anchor":"for","translations":[{"language":"ms","lang_name":"Malay"}]}]}
