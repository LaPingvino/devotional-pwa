{"pin":"BH01208","subcodes":[{"code":"BH01208","anchor":"","first_line":"O Muhammad! Be content with thy Lord and detach thyself from whatsoever hath been created in the dust, for verily the dust and all that proceedeth therefrom shall pass away [3.5s]... ...Glory be unto Thee, O my God! I beg of Thee, by the Lights of Thy Beauty, the Exalted, the Supreme","first_line_orig":"ان یا محمد فاکف بربک و کن مستغنیا عما خلق فی التراب لان التراب و ما یحدث منه  ","language":"Ara","word_count":"690","translations":[],"refs":[{"kind":"manuscript","code":"INBA33:020bx","source":"INBA33","locator":"020bx","url":"https://afnanlibrary.org/d/inba_v033/?page=22"},{"kind":"manuscript","code":"INBA92:219","source":"INBA92","locator":"219","url":"https://afnanlibrary.org/d/inba_v092-dark/?page=112"},{"kind":"manuscript","code":"NLAI_BH1.242","source":"NLAI_BH1","locator":"242","url":"http://bluefin.live/wp-content/uploads/2022/08/NLAI.BH1_.pdf#page=264"},{"kind":"publication","code":"ADM3#139 p.157x","source":"ADM3","locator":"139 p.157x","url":"https://bahai-library.com/bahailib/559.pdf#page=158"},{"kind":"translation","code":"BSTW#035x","source":"BSTW","locator":"035x","url":"http://www.h-net.org/~bahai/docs/vol13/Barstow_000-050.pdf#page=46"},{"kind":"translation","code":"JHT_S#067x","source":"JHT_S","locator":"067x","url":"https://joshuahalltranslations.com/jalal/2017/10/Supplications-by-Bahaullah-1.pdf#page=32"}]},{"code":"BH01208SPL","anchor":"spl","translations":[{"language":"pt","lang_name":"Portuguese"},{"language":"zh-Hans","lang_name":"Simplified Chinese"},{"language":"en","lang_name":"English"},{"language":"nl","lang_name":"Dutch"}]}]}
