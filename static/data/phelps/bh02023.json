{"pin":"BH02023","subcodes":[{"code":"BH02023","anchor":"","first_line":"Magnified be Thy Name, O my God!  I love to call on Thee with every tongue, to implore Thee with every utterance, to remember Thee with every heart","first_line_orig":"سبحانک اللهم یا الهی احب بکل لسان ادعوک و بکل بیان ارجوک و بکل قلب اذکرک  ","language":"mixed","word_count":"440","translations":[{"language":"ar","lang_name":"Arabic"},{"language":"orig","lang_name":"Original"}],"refs":[{"kind":"manuscript","code":"INBA30:118x","source":"INBA30","locator":"118x","url":"https://afnanlibrary.org/d/inba_v030/?page=63"},{"kind":"publication","code":"ADH1.044","source":"ADH1","locator":"044","url":"https://bahai-library.com/pdf/i/ishraq-khavari_adhkar_muqarrabin_1.pdf"},{"kind":"publication","code":"AHM.054","source":"AHM","locator":"054","url":"http://reference.bahai.org/fa/t/b/AHM/ahm-54.html"},{"kind":"publication","code":"AQMJ1.022x","source":"AQMJ1","locator":"022x","url":"http://reference.bahai.org/fa/t/b/MMQ1/mmq1-24.html"},{"kind":"publication","code":"ASAT4.393x","source":"ASAT4","locator":"393x","url":"https://bahai-library.com/bahailib/430.pdf#page=198"},{"kind":"translation","code":"ADMS#118","source":"ADMS","locator":"118","url":"https://adibmasumian.com/translations/bh02023/"}]}]}
