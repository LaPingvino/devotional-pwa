{"pin":"BH02562","subcodes":[{"code":"BH02562","anchor":"","first_line":"O thou who gazest towards God and walkest in His good-pleasure! Know thou that We verily inform thee of what shall come to pass, for it is inevitable [3.5s]","first_line_orig":"یا ایها الناظر الی الله و السالک فی رضاه فاعلم انا نخبرک بما سیکون انه لابد  ","language":"Ara","word_count":"350","translations":[{"language":"ar","lang_name":"Arabic"},{"language":"tr","lang_name":"Turkish"},{"language":"orig","lang_name":"Original"}],"refs":[{"kind":"manuscript","code":"INBA34:188","source":"INBA34","locator":"188","url":"https://afnanlibrary.org/d/inba_v034/?page=190"},{"kind":"publication","code":"AQA1#053","source":"AQA1","locator":"053","url":"https://reference.bahai.org/fa/t/b/Q1/q1-58.html"},{"kind":"publication","code":"AVK4.418bx","source":"AVK4","locator":"418bx","url":"http://reference.bahai.org/fa/t/c/AK4/ak4-422.html"},{"kind":"publication","code":"MAS8.039cx","source":"MAS8","locator":"039cx","url":"http://reference.bahai.org/fa/t/b/MAS8/mas8-39.html"}]}]}
