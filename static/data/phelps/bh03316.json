{"pin":"BH03316","subcodes":[{"code":"BH03316","anchor":"","first_line":"My God, my God! Nearness to Thee is my hope, pardon from Thee my desire, Thy good-pleasure with me my aspiration, and forgiveness from Thee my highest and most cherished aim","first_line_orig":"الهی الهی قربک رجائی و عفوک املی و رضائک بغیتی و غفرانک منتهی مطلبی اسئلک  ","language":"Ara","word_count":"270","translations":[{"language":"ar","lang_name":"Arabic"},{"language":"zh-Hans","lang_name":"Simplified Chinese"},{"language":"orig","lang_name":"Original"}],"refs":[{"kind":"manuscript","code":"INBA61:067","source":"INBA61","locator":"067","url":"https://afnanlibrary.org/d/inba_v061/?page=70"},{"kind":"music","code":"almunajat.com [item 33]","source":"almunajat","locator":"com [item 33]","url":"https://almunajat.com/chanting_collection_2.htm"},{"kind":"publication","code":"ADM2#086 p.158","source":"ADM2","locator":"086 p.158","url":"https://bahai-library.com/bahailib/558.pdf#page=158"},{"kind":"translation","code":"JHT_S#045","source":"JHT_S","locator":"045","url":"https://joshuahalltranslations.com/jalal/2017/10/Supplications-by-Bahaullah-1.pdf#page=21"}]}]}
