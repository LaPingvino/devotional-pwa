{"pin":"BH05241","subcodes":[{"code":"BH05241","anchor":"","first_line":"O My Leaf! With the ear of thy soul hearken thou unto the Call of the All-Merciful, Who hath turned towards thee from the Most Great Prison and maketh mention of thee [3.5s]... ...Know thou that every hearing ear, if kept pure and undefiled, must, at all times and from every direction, hearken to the voice that uttereth these holy words","first_line_orig":"یا ورقتی بگوش جان ندای رحمن را بشنو از سجن اعظم بتو توجه نموده و ترا بذکر  ","language":"mixed","word_count":"190","notes":" \u003ca href=\"http://web.archive.org/web/20070930181707/http://bahai-library.com/resources/leiden.list/leiden.list.html#387\"\u003eLL#387\u003c/a\u003e","translations":[{"language":"kn","lang_name":"Kannada"}],"writing_refs":[{"type":"gleanings","type_name":"Gleanings","language":"es","lang_name":"Spanish"},{"type":"gleanings","type_name":"Gleanings","language":"vi","lang_name":"Vietnamese"},{"type":"gleanings","type_name":"Gleanings","language":"kn","lang_name":"Kannada"},{"type":"gleanings","type_name":"Gleanings","language":"ar","lang_name":"Arabic"},{"type":"gleanings","type_name":"Gleanings","language":"fr","lang_name":"French"},{"type":"gleanings","type_name":"Gleanings","language":"pt","lang_name":"Portuguese"},{"type":"gleanings","type_name":"Gleanings","language":"orig","lang_name":"Original"},{"type":"gleanings","type_name":"Gleanings","language":"it","lang_name":"Italian"},{"type":"gleanings","type_name":"Gleanings","language":"sk","lang_name":"Slovak"},{"type":"gleanings","type_name":"Gleanings","language":"en","lang_name":"English"},{"type":"gleanings","type_name":"Gleanings","language":"hu","lang_name":"Hungarian"},{"type":"gleanings","type_name":"Gleanings","language":"ja","lang_name":"Japanese"},{"type":"gleanings","type_name":"Gleanings","language":"ta","lang_name":"Tamil"},{"type":"gleanings","type_name":"Gleanings","language":"ko","lang_name":"Korean"},{"type":"gleanings","type_name":"Gleanings","lan