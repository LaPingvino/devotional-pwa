{"pin":"BH07261","subcodes":[{"code":"BH07261","anchor":"","first_line":"O Thou Who art the All-Merciful, the Most Compassionate! I bear witness to Thy oneness and Thy singleness, and I seek from Thee that which shall last","first_line_orig":"گواهی میدهم بوحدانیت و فردانیت تو و از تو میطلبم آنچه را که بدوام ملک و  ","language":"Per","word_count":"140","translations":[{"language":"mn","lang_name":"Mongolian"},{"language":"fa","lang_name":"Persian"},{"language":"en","lang_name":"English"},{"language":"tr","lang_name":"Turkish"},{"language":"orig","lang_name":"Original"}],"refs":[{"kind":"manuscript","code":"INBA30:099","source":"INBA30","locator":"099","url":"https://afnanlibrary.org/d/inba_v030/?page=54"},{"kind":"manuscript","code":"INBA65:056","source":"INBA65","locator":"056","url":"https://afnanlibrary.org/d/inba_v065/?page=58"},{"kind":"publication","code":"ADH1.095","source":"ADH1","locator":"095","url":"https://bahai-library.com/pdf/i/ishraq-khavari_adhkar_muqarrabin_1.pdf"},{"kind":"publication","code":"AHM.348","source":"AHM","locator":"348","url":"http://reference.bahai.org/fa/t/b/AHM/ahm-348.html"},{"kind":"publication","code":"AKHA_133BE #16 p.514","source":"AKHA_133BE #16 p.514","url":"https://afnanlibrary.org/akhbar-i-amri/"},{"kind":"publication","code":"AQMJ1.162","source":"AQMJ1","locator":"162","url":"http://reference.bahai.org/fa/t/b/MMQ1/mmq1-164.html"},{"kind":"translation","code":"ADMS#073","source":"ADMS","locator":"073","url":"https://adibmasumian.com/translations/bahaullah-prayer-ahm-348-350/"}]}]}
