{"pin":"BH08846","subcodes":[{"code":"BH08846","anchor":"","first_line":"Glory be to Thee, O my God! I beg of Thee by Thy name, the Most Merciful, to protect Thy servants and Thy handmaidens","first_line_orig":"سبحانک یا الهی اسئلک باسمک الرحمن بان تحفظ عبادک و امائک عند هبوب اریاح  ","language":"Ara","word_count":"110","full_text_parts":["Glory be to Thee, O my God! I beg of Thee by Thy name, the Most Merciful, to protect Thy servants and Thy handmaidens when the tempests of trials pass over them, and Thy manifold tests assail them. Enable them, then, O my God, so to seek refuge within the stronghold of Thy love and of Thy Revelation, that neither Thine adversaries nor the wicked doers among Thy servants, who have broken Thy Covenant and Thy Testament, and turned away most disdainfully from the Dayspring of Thine Essence and the Revealer of Thy glory, may prevail against them.\n\nThey themselves, O my Lord, have waited at the door of Thy grace. Do Thou open it to their faces with the keys of Thy bountiful favors. Potent art Thou to do what Thou willest, and to ordain what Thou pleasest. These are the ones, O my Lord, who have set their faces towards Thee, and turned unto Thy","habitation. Do with them, therefore, as becometh Thy mercy, which hath surpassed the worlds.\n\n\n* Prayers and Meditations, CXLIII"],"translations":[{"language":"ml","lang_name":"Malayalam"},{"language":"es","lang_name":"Spanish"},{"language":"bg","lang_name":"Bulgarian"},{"language":"hi","lang_name":"Hindi"},{"language":"ro","lang_name":"Romanian"},{"language":"zh-Hant","lang_name":"Traditional Chinese"},{"language":"sv","lang_name":"Swedish"},{"language":"tl","lang_name":"Tagalog"},{"language":"uk","lang_name":"Ukrainian"},{"language":"fi","lang_name":"Finnish"},{"language":"iba","lang_name":"Iban"},{"language":"ja","lang_name":"Japanese"},{"language":"fa","lang_name":"Persian"},{"language":"fr","lang_name":"French"},{"language":"ha","lang_name":"Hausa"},{"language":"ms","lang_name":"Malay"},{"language":"gu","lang_name":"Gujarati"},{"language":"hr","lang_name":"Croatian"},{"language":"zh-Hans","lang_name":"Simplified Chinese"},{"language":"af","lang_name":"Afrikaans"},{"language":"en","lang_name":"English"},{"language":"ne","lang_name":"Nepali"},{"language":"it","lang_name":"Italian"},{"language":"sk","lang_name":"Slovak"},{"language":"nl","lang_name":"Dutch"}],"writing_refs":[{"type":"pm","type_name":"Prayers \u0026 Meditations","language":"ja","lang_name":"Japanese"},{"type":"pm","type_name":"Prayers \u0026 Meditations","language":"ml","lang_name":"Malayalam"},{"type":"pm","type_name":"Prayers \u0026 Meditations","language":"zh-Hant","lang_name":"Traditional Chinese"},{"type":"pm","type_name":"Prayers \u0026 Meditations","language":"ro","lang_name":"Romanian"},{"type":"pm","type_name":"Prayers \u0026 Meditations","language":"fa","lang_name":"Persian"},{"type":"pm","type_name":"Prayers \u0026 Meditations","language":"sv","lang_name":"Swedish"},{"type":"pm","type_name":"Prayers \u0026 Meditations","language":"fr","lang_name":"French"},{"type":"pm","type_name":"Prayers \u0026 Meditations","language":"uk","lang_name":"Ukrainian"},{"type":"pm","type_name":"Prayers \u0026 Meditations","language":"af","lang_name":"Afrikaans"},{"type":"pm","type_name":"Prayers \u0026 Meditations","language":"sk","lang_name":"Slovak"},{"type":"pm","type_name":"Prayers \u0026 Meditations","language":"zh-Hans","lang_name":"Simplified Chinese"},{"type":"pm","type_name":"Prayers \u0026 Meditations","language":"en","lang_name":"English"},{"type":"pm","type_name":"Prayers \u0026 Meditations","language":"tvl","lang_name":"Tuvalu"},{"type":"pm","type_name":"Prayers \u0026 Meditations","language":"ne","lang_name":"Nepali"},{"type":"pm","type_name":"Prayers \u0026 Meditations","language":"fi","lang_name":"Finnish"},{"type":"pm","type_name":"Prayers \u0026 Meditations","language":"tl","lang_name":"Tagalog"},{"type":"pm","type_name":"Prayers \u0026 Meditations","language":"orig","lang_