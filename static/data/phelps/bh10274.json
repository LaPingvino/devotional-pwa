{"pin":"BH10274","subcodes":[{"code":"BH10274","anchor":"","first_line":"Magnified be Thy name, O God, the Lord of heaven! Attire my head with the crown of martyrdom","first_line_orig":"سبحانک اللهم یا اله السماء زین راس البهاء بتاج الشهاده فی سبیلک کما زینت هیکله  ","language":"Ara","word_count":"80","full_text_parts":["Magnified be Thy name, O God, the Lord of heaven!  Attire my head with the crown of martyrdom, even as Thou didst attire my body with the ornament of tribulation before all that dwell in Thy land.  Grant, moreover, that they whose hearts yearn over Thee may draw nigh unto the horizon of Thy grace, above which the Day-Star of Thy beauty sheddeth its radiance.  Ordain, also, for them what will make them rich enough to dispense with aught else except Thee, and rid them of all attachment to such as have repudiated Thy signs.\n\nThere is none other God but Thee, the Guardian, the Self-Subsisting.\n\n* Prayers and Meditations, XVII"],"translations":[{"language":"no","lang_name":"Norwegian"},{"language":"mg","lang_name":"Malagasy"},{"language":"pt","lang_name":"Portuguese"},{"language":"ms","lang_name":"Malay"},{"language":"hu","lang_name":"Hungarian"},{"language":"en","lang_name":"English"},{"language":"sk","lang_name":"Slovak"},{"language":"tvl","lang_name":"Tuvalu"}],"writing_refs":[{"type":"pm","type_name":"Prayers \u0026 Meditations","language":"mg","lang_name":"Malagasy"},{"type":"pm","type_name":"Prayers \u0026 Meditations","language":"sk","lang_name":"Slovak"},{"type":"pm","type_name":"Prayers \u0026 Meditations","language":"en","lang_name":"English"},{"type":"pm","type_name":"Prayers \u0026 Meditations","language":"tvl","lang_name":"Tuvalu"},{"type":"pm","type_name":"Prayers \u0026 Meditations","language":"orig","lang_name":"Original"},{"type":"pm","type_name":"Prayers \u0026 Meditations","language":"hu","lang_name":"Hungarian"},{"type":"pm","type_name":"Prayers \u0026 Meditations","language":"pt","lang_name":"Portuguese"},{"type":"pm","type_name":"Prayers \u0026 Meditations","language":"it","lang_name":"Italian"},{"type":"pm","type_name":"Prayers \u0026 Meditations","language":"ms","lang_name":"Malay"},{"type":"pm","type_name":"Prayers \u0026 Meditations","language":"no","lang_name":"Norwegian"},{"type":"pm","type_name":"Prayers \u0026 Meditations","language":"ar","lang_name":"Arabic"},{"type":"pm","type_name":"Prayers \u0026 Meditations","language":"es","lang_name":"Spanish"},{"type":"pm","type_name":"Prayers \u0026 Meditations","language":"de","lang_name":"German"}],"refs":[{"kind":"manuscript","code":"INBA92:383a","source":"INBA92","locator":"383a","url":"https://afnanlibrary.org/d/inba_v092-dark/?page=194"},{"kind":"publication","code":"AQMJ2.047b","source":"AQMJ2","locator":"047b","url":"http://reference.bahai.org/fa/t/b/MMQ2/mmq2-48.html"},{"kind":"publication","code":"PMP#017","source":"PMP","locator":"017","url":"http://www.bahai.org/r/735563611"},{"kind":"translation","code":"PM#017","source":"PM","locator":"017","url":"http://www.bahai.org/r/959973595"}]}]}
