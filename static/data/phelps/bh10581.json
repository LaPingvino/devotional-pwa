{"pin":"BH10581","subcodes":[{"code":"BH10581","anchor":"","first_line":"Praise be unto Thee, O Lord my God! We have observed the Fast in conformity with Thy bidding","first_line_orig":"سبحانک اللهم یا الهی انا صمنا بامرک و افطرنا بحبک و رضائک فاقبل منا یا الهی  ","language":"Ara","word_count":"70","notes":" \u003ca href=\"http://web.archive.org/web/20070930181707/http://bahai-library.com/resources/leiden.list/leiden.list.html#271\"\u003eLL#271\u003c/a\u003e","full_text_parts":["Praise be unto Thee, O Lord my God!  We have observed the Fast in conformity with Thy bidding and break it now through Thy love and Thy good-pleasure.  Deign to accept, O my God, the deeds that we have performed in Thy path wholly for the sake of Thy beauty with our faces set towards Thy Cause, free from aught else but Thee.  Bestow, then, Thy forgiveness upon us, upon our forefathers, and upon all such as have believed in Thee and in Thy mighty signs in this most great, this most glorious Revelation.  Potent art Thou to do what Thou choosest. Thou art, verily, the Most Exalted, the Almighty, the Unconstrained."],"translations":[{"language":"pt","lang_name":"Portuguese"},{"language":"ca","lang_name":"Catalan"},{"language":"ar","lang_name":"Arabic"},{"language":"am","lang_name":"Amharic"},{"language":"sk","lang_name":"Slovak"},{"language":"fi","lang_name":"Finnish"},{"language":"is","lang_name":"Icelandic"},{"language":"tvl","lang_name":"Tuvalu"},{"language":"ms","lang_name":"Malay"},{"language":"ja","lang_name":"Japanese"},{"language":"ro","lang_name":"Romanian"},{"language":"nl","lang_name":"Dutch"},{"language":"es","lang_name":"Spanish"},{"language":"en","lang_name":"English"},{"language":"sne","lang_name":"Bau Bidayuh"},{"language":"gil","lang_name":"Gilbertese"},{"language":"ht","lang_name":"Haitian Creole"},{"language":"da","lang_name":"Danish"},{"language":"de","lang_name":"German"},{"language":"orig","lang_name":"Original"},{"language":"uk","lang_name":"Ukrainian"},{"language":"cs","lang_name":"Czech"},{"language":"az","lang_name":"Azerbaijani"},{"language":"el","lang_name":"Greek"},{"language":"ky","lang_name":"Kirghiz"},{"language":"mn","lang_name":"Mongolian"},{"language":"iba","lang_name":"Iban"}],"writing_refs":[{"type":"pm","type_name":"Prayers \u0026 Meditations","language":"pl","lang_name":"Polish"}],"refs":[{"kind":"music","code":"unknown","source":"unknown","url":"https://youtu.be/bTS4SEwDvYg"},{"kind":"publication","code":"ANDA#29 p.03","source":"ANDA","locator":"29 p.03","url":"https://www.afnanlibrary.org/d/andalib-issue-29"},{"kind":"publication","code":"HDQI.126b","source":"HDQI","locator":"126b","url":"http://reference.bahai.org/fa/t/c/HI/hi-131.html"},{"kind":"publication","code":"OOL.B090.11","source":"OOL","locator":"B090.11","url":"https://oceanoflights.org/bahaullah-st-090-11-ar"},{"kind":"translation","code":"BPRY.285","source":"BPRY","locator":"285","url":"http://www.bahai.org/r/441659040"},{"kind":"translation","code":"BRL_IOPF#3.03","source":"BRL_IOPF","locator":"3.03","url":"http://www.bahai.org/r/865350547"}]}]}
